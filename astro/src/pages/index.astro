---
import Layout from "@/layouts/Layout.astro";
import {storiesByStudy} from "@/lib/registry";
import {isVisible} from "@/lib/visibility";
import {loadCompaniesManifest} from "@/lib/data";
import {getCollection} from "astro:content";

const groups = await storiesByStudy();

const companies = (await loadCompaniesManifest())
  .map((c) => ({id: c.id, displayName: c.displayName}))
  .sort((a, b) => a.displayName.localeCompare(b.displayName));

const essays = (
  await getCollection("essays", (e) => isVisible(e.data.published))
).sort((a, b) => a.data.title.localeCompare(b.data.title));

// Companion writing, published on Substack.
const relatedWriting = [
  {
    title: "Masculine Energy",
    href: "https://beccabailey.substack.com/p/masculine-energy",
  },
  {
    title: "Deeply Resentful",
    href: "https://beccabailey.substack.com/p/deeply-resentful",
  },
  {
    title: "The Death of Changing the World",
    href: "https://open.substack.com/pub/beccabailey/p/the-death-of-changing-the-world",
  },
  {
    title: "A Team, Not a Family",
    href: "https://open.substack.com/pub/beccabailey/p/a-team-not-a-family",
  },
  {
    title: "Millennials Were Supposed to Fix Work",
    href: "https://beccabailey.substack.com/p/bb503447-8aa3-4e59-af99-bb62c57f8a02",
  },
];

const sourceUrl = "https://github.com/becca-bailey/language-of-work";
---

<Layout>
  <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-16">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-500">
      The Language of Work
    </p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">
      How companies talk about work
    </h1>
    <div class="mt-4 max-w-prose space-y-4 text-neutral-600 dark:text-neutral-400">
      <p>
        Careers pages are corporate self-presentation at its most deliberate —
        every word chosen to attract workers. This is a computational study of
        a quarter century of them (two dozen tech companies, 1999–2026,
        reconstructed from the Wayback Machine), read as a longitudinal record:
        what the language does over time, when it shifts, and why. Movement is
        tracked as position along embedding-based semantic axes.
      </p>
      <p>
        The thread running through the studies is <strong
          class="font-medium text-neutral-800 dark:text-neutral-200"
          >selection under leverage</strong
        >: a careers page is an audience-selection device, and its language
        records who the company needed to persuade — or was willing to lose —
        at each moment. When workers had somewhere else to go, the pages
        filled with belonging, care, and diversity commitments; as that
        leverage receded, the concessions deflated, the surviving care
        individualized, and an openly exclusionary register ("we're not for
        everyone") spread. Underneath both swings, the language that serves
        the employer — performance, merit, the unmeasured "high bar" — holds
        steady in every market. The 2010s bet that a new generation would
        permanently fix work wasn't wrong so much as rented: the gains
        tracked the labor market, and receded the moment it inverted.
      </p>
    </div>

    {
      groups.map(({study, stories}) => (
        <section class="mt-12">
          <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
            {study.name}
          </h2>
          <p class="mt-2 max-w-prose text-sm text-neutral-500 dark:text-neutral-400">
            {study.blurb}
          </p>
          <ul class="mt-4 space-y-2">
            {stories.map((story) => (
              <li>
                <a
                  href={`/stories/${story.id}/`}
                  class="group flex items-baseline justify-between gap-4 rounded-lg border border-info/30 bg-info/8 px-4 py-3 transition-colors hover:border-info"
                >
                  <span>
                    <span class="font-medium">{story.data.title}</span>
                    <span class="mt-0.5 block text-sm text-neutral-500 dark:text-neutral-400">
                      {story.data.teaser}
                    </span>
                  </span>
                  <span class="text-sm text-neutral-400 transition-transform group-hover:translate-x-0.5">
                    &rarr;
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="mt-12">
      <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
        How it's built
      </h2>
      <div class="mt-2 max-w-prose space-y-3 text-sm text-neutral-500 dark:text-neutral-400">
        <p>
          A Python pipeline chunks archived careers pages, classifies them
          with an LLM, and scores them on embedding-based contrast axes, each
          paired with a neutral control. An axis publishes only after
          agreement checks against blind hand-labeled samples and an
          LLM-judge re-ranking that reads the actual quotes; where the data
          can't carry a claim, the story says so. Each chart states what it
          measures and cites its sources below the figure. Full method
          detail, reliability numbers, and code are in the
          <a
            href="https://github.com/becca-bailey/language-of-work"
            class="underline decoration-neutral-300 underline-offset-2 dark:decoration-neutral-700"
            >repository</a
          >. The site is Astro, React, and visx.
        </p>
      </div>
    </section>

    {
      companies.length > 0 && (
        <section class="mt-12">
          <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
            Companies
          </h2>
          <p class="mt-2 max-w-prose text-sm text-neutral-500 dark:text-neutral-400">
            A per-company overview of everything the careers pages reveal.
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {companies.map((c) => (
              <li>
                <a
                  href={`/explore/${c.id}/`}
                  class="inline-block rounded-lg border border-neutral-200 px-3 py-1.5 text-sm transition-colors hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-600"
                >
                  {c.displayName}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      essays.length > 0 && (
        <section class="mt-12">
          <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
            Essays
          </h2>
          <ul class="mt-4 space-y-2">
            {essays.map((essay) => (
              <li>
                <a
                  href={`/essays/${essay.id}/`}
                  class="group flex items-baseline justify-between gap-4 rounded-lg border border-alert/30 bg-alert/8 px-4 py-3 transition-colors hover:border-alert"
                >
                  <span>
                    <span class="font-medium">{essay.data.title}</span>
                    {essay.data.teaser && (
                      <span class="mt-0.5 block text-sm text-neutral-500 dark:text-neutral-400">
                        {essay.data.teaser}
                      </span>
                    )}
                  </span>
                  <span class="text-sm text-neutral-400 transition-transform group-hover:translate-x-0.5">
                    &rarr;
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-12">
      <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
        Related writing
      </h2>
      <p class="mt-2 max-w-prose text-sm text-neutral-500 dark:text-neutral-400">
        Companion essays on Substack, and the source behind the studies.
      </p>
      <ul class="mt-4 space-y-2">
        {
          relatedWriting.map((piece) => (
            <li>
              <a
                href={piece.href}
                target="_blank"
                rel="noopener"
                class="group flex items-baseline justify-between gap-4 text-sm text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
              >
                <span class="font-medium underline decoration-neutral-300 underline-offset-4 dark:decoration-neutral-700">
                  {piece.title}
                </span>
                <span class="text-neutral-400 transition-transform group-hover:translate-x-0.5">
                  &#8599;
                </span>
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={sourceUrl}
            target="_blank"
            rel="noopener"
            class="group flex items-baseline justify-between gap-4 text-sm text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
          >
            <span class="font-medium underline decoration-neutral-300 underline-offset-4 dark:decoration-neutral-700">
              Source on GitHub
            </span>
            <span class="text-neutral-400 transition-transform group-hover:translate-x-0.5">
              &#8599;
            </span>
          </a>
        </li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
        About
      </h2>
      <p class="mt-2 max-w-prose text-sm text-neutral-500 dark:text-neutral-400">
        I'm Becca Bailey, a software engineer. This project started as
        curiosity about why job listings all sound the same, and grew into the
        corpus and pipeline behind these stories. I'm not a trained researcher,
        so the validation above is how I keep myself honest — and the code is
        public so you can check. More of my work is at <a
          href="https://becca.is"
          target="_blank"
          rel="noopener"
          class="underline decoration-neutral-300 underline-offset-4 hover:text-neutral-900 dark:decoration-neutral-700 dark:hover:text-neutral-100"
          >becca.is</a
        >.
      </p>
    </section>
  </main>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import {storiesByStudy} from "@/lib/registry";
import {isVisible} from "@/lib/visibility";
import {loadCompaniesManifest} from "@/lib/data";
import {getCollection} from "astro:content";

const groups = await storiesByStudy();

const companies = (await loadCompaniesManifest())
  .map((c) => ({id: c.id, displayName: c.displayName}))
  .sort((a, b) => a.displayName.localeCompare(b.displayName));

const essays = (
  await getCollection("essays", (e) => isVisible(e.data.published))
).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout>
  <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-16">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-500">
      The Language of Work
    </p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">
      How companies talk about work
    </h1>
    <p class="mt-4 max-w-prose text-neutral-600 dark:text-neutral-400">
      A set of studies measuring the language companies use about themselves —
      as employers, as missions, as cultures — and how it shifts over time,
      tracked as movement along embedding-based semantic axes.
    </p>

    {
      groups.map(({study, stories}) => (
        <section class="mt-12">
          <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
            {study.name}
          </h2>
          <p class="mt-2 max-w-prose text-sm text-neutral-500 dark:text-neutral-400">
            {study.blurb}
          </p>
          <ul class="mt-4 space-y-2">
            {stories.map((story) => (
              <li>
                <a
                  href={`/stories/${story.id}/`}
                  class="group flex items-baseline justify-between gap-4 rounded-lg border border-indigo-200 bg-indigo-50/50 px-4 py-3 transition-colors hover:border-indigo-400 dark:border-indigo-900 dark:bg-indigo-950/30 dark:hover:border-indigo-700"
                >
                  <span>
                    <span class="font-medium">{story.data.title}</span>
                    <span class="mt-0.5 block text-sm text-neutral-500 dark:text-neutral-400">
                      {story.data.teaser}
                    </span>
                  </span>
                  <span class="text-sm text-neutral-400 transition-transform group-hover:translate-x-0.5">
                    &rarr;
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {
      companies.length > 0 && (
        <section class="mt-12">
          <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
            Companies
          </h2>
          <p class="mt-2 max-w-prose text-sm text-neutral-500 dark:text-neutral-400">
            A per-company overview of everything the careers pages reveal.
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {companies.map((c) => (
              <li>
                <a
                  href={`/explore/${c.id}/`}
                  class="inline-block rounded-lg border border-neutral-200 px-3 py-1.5 text-sm transition-colors hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-600"
                >
                  {c.displayName}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      essays.length > 0 && (
        <section class="mt-12">
          <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
            Essays
          </h2>
          <ul class="mt-4 space-y-2">
            {essays.map((essay) => (
              <li>
                <a
                  href={`/essays/${essay.id}/`}
                  class="group flex items-baseline justify-between gap-4 rounded-lg border border-rose-200 bg-rose-50/50 px-4 py-3 transition-colors hover:border-rose-400 dark:border-rose-900 dark:bg-rose-950/30 dark:hover:border-rose-700"
                >
                  <span>
                    <span class="font-medium">{essay.data.title}</span>
                    {essay.data.teaser && (
                      <span class="mt-0.5 block text-sm text-neutral-500 dark:text-neutral-400">
                        {essay.data.teaser}
                      </span>
                    )}
                  </span>
                  <span class="text-sm text-neutral-400 transition-transform group-hover:translate-x-0.5">
                    &rarr;
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Layout>

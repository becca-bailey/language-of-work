---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const essays = await getCollection("essays");
  return essays.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.teaser ?? entry.data.subtitle}>
  <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-12">
    <a
      href="/"
      class="text-sm text-neutral-500 transition-colors hover:text-neutral-800 dark:hover:text-neutral-200"
    >
      &larr; Home
    </a>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight">{entry.data.title}</h1>
    {entry.data.subtitle && (
      <p class="mt-3 max-w-prose text-lg text-neutral-600 dark:text-neutral-400">
        {entry.data.subtitle}
      </p>
    )}

    <article class="essay-prose mt-10">
      <Content />
    </article>
  </main>
</Layout>

<style is:global>
  /* Lightweight prose styling for MDX essays (no @tailwindcss/typography dep). */
  .essay-prose {
    line-height: 1.7;
  }
  .essay-prose h2 {
    margin-top: 3rem;
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .essay-prose h3 {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
    font-weight: 500;
  }
  .essay-prose p {
    margin-top: 1rem;
    max-width: 65ch;
  }
  .essay-prose ul {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    padding-left: 1rem;
    max-width: 65ch;
    list-style: none;
    border-left: 2px solid color-mix(in srgb, currentColor 15%, transparent);
  }
  .essay-prose li {
    margin-top: 0.25rem;
    padding-left: 0.75rem;
    font-size: 0.9rem;
    color: color-mix(in srgb, currentColor 60%, transparent);
  }
  .essay-prose blockquote {
    margin-top: 1.5rem;
    border: 1px dashed color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 0.375rem;
    padding: 0.75rem;
    font-size: 0.75rem;
    color: color-mix(in srgb, currentColor 55%, transparent);
  }
  .essay-prose blockquote p {
    margin-top: 0;
    max-width: none;
  }
</style>

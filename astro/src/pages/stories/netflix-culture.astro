---
import Layout from "@/layouts/Layout.astro";
import NetflixStoryExplorer from "@/components/NetflixStoryExplorer";
import { loadNetflixStory } from "@/lib/netflixStory";

const data = await loadNetflixStory();
if (!data) return Astro.redirect("/404");
---

<Layout title={data.title}>
  <main class="mx-auto w-full max-w-4xl flex-1 px-6 py-12">
    <a
      href="/"
      class="text-sm text-neutral-500 transition-colors hover:text-neutral-800 dark:hover:text-neutral-200"
    >
      &larr; Stories
    </a>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight">{data.title}</h1>
    <p class="mt-2 max-w-prose text-lg text-neutral-600 dark:text-neutral-400">
      {data.subtitle}
    </p>
    <div class="mt-8">
      <NetflixStoryExplorer data={data} client:only="react" />
    </div>
  </main>
</Layout>

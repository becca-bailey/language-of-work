---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page not found">
  <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-16">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-500">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-4 max-w-prose text-neutral-600 dark:text-neutral-400">
      This page doesn&apos;t exist, or the data for it hasn&apos;t been exported yet.
    </p>
    <a
      href="/"
      class="mt-8 inline-block text-sm text-info hover:underline"
    >
      &larr; Back to stories
    </a>
  </main>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import AxisExplorer from "@/components/AxisExplorer";
import TrajectoryChart from "@/components/TrajectoryChart";
import DeiExplorer from "@/components/DeiExplorer";
import ValuesFingerprint from "@/components/ValuesFingerprint";
import {
  loadAxis,
  loadDei,
  loadCompaniesManifest,
  loadSynthesis,
  loadFingerprint,
} from "@/lib/data";

// Axes shown as trajectory small-multiples, in display order. `control` and
// `dei` get their own richer explorers below, so they're handled separately.
const TRAJECTORY_AXES: { axis: string; label: string }[] = [
  { axis: "performance", label: "Performance intensity" },
  { axis: "meritocracy", label: "Meritocracy" },
  { axis: "wellbeing", label: "Wellbeing & balance" },
  // inclusion is omitted: the DEI explorer below shows the same axis in detail.
  { axis: "techno_optimism", label: "Techno-optimism" },
  { axis: "craft", label: "Craft vs iteration" },
];

export async function getStaticPaths() {
  // Every company in the manifest (anything we have axis/dei data on) gets a page.
  const manifest = await loadCompaniesManifest();
  return manifest.map((c) => ({ params: { company: c.id } }));
}

const { company } = Astro.params as { company: string };

const [manifest, altruism, control, dei, synthesis, fingerprint, trajectories] =
  await Promise.all([
    loadCompaniesManifest(),
    loadAxis(company, "altruism"),
    loadAxis(company, "control"),
    loadDei(company),
    loadSynthesis(company),
    loadFingerprint(company),
    Promise.all(TRAJECTORY_AXES.map((t) => loadAxis(company, t.axis))),
  ]);

// Pair each trajectory axis with its loaded data; keep only those with ≥2 points.
const trajectoryPanels = TRAJECTORY_AXES.map((t, i) => ({
  ...t,
  data: trajectories[i],
}))
  .filter((p) => p.data && p.data.years.length >= 2)
  .map((p) => ({
    label: p.label,
    rows: p.data!.years.map((y) => ({
      year: y.year,
      value: y.zscore,
      control: null,
      thin: y.thin,
      nItems: y.nChunks,
      kUsed: y.kUsed,
    })),
  }));

const hasNarrative = synthesis && synthesis.sections.length > 0;

const manifestEntry = manifest.find((c) => c.id === company) ?? null;
const displayName =
  manifestEntry?.displayName ?? synthesis?.displayName ?? altruism?.displayName ?? dei?.displayName ?? company;

if (!synthesis && !altruism && !dei) return Astro.redirect("/404");

// The most idealistic line on record — a concrete sample of how they pitch mission.
const peakQuote = (() => {
  if (!altruism || altruism.years.length === 0) return null;
  const peak = altruism.years.reduce((best, y) => (y.zscore > best.zscore ? y : best));
  const quote = peak.quotes?.[0];
  return quote ? { year: peak.year, text: quote.text } : null;
})();
---

<Layout title={`${displayName} — what their careers pages say`}>
  <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-12">
    <a
      href="/"
      class="text-sm text-neutral-500 transition-colors hover:text-neutral-800 dark:hover:text-neutral-200"
    >
      &larr; all companies
    </a>

    <h1 class="mt-4 text-3xl font-semibold tracking-tight">{displayName}</h1>
    <p class="mt-3 max-w-prose text-neutral-600 dark:text-neutral-400">
      What {displayName}'s own careers pages — archived from the Wayback Machine — say about
      working there, and how that language has shifted over time. A read for anyone weighing
      whether to apply. This is how the company <em>describes</em> itself, not how it necessarily
      behaves.
    </p>

    {(synthesis?.headline || synthesis?.identity) && (
      <section class="mt-10">
        {synthesis.headline && (
          <p class="max-w-prose text-xl font-medium leading-relaxed">{synthesis.headline}</p>
        )}
        {synthesis.identity && (
          <p class="mt-4 max-w-prose leading-relaxed text-neutral-700 dark:text-neutral-300">
            {synthesis.identity}
          </p>
        )}
      </section>
    )}

    {fingerprint && fingerprint.axes.length > 0 && (
      <section class="mt-12">
        <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
          Values fingerprint
        </h2>
        <p class="mt-3 max-w-prose text-sm text-neutral-500">
          Where {displayName}'s careers language leans heavier (or lighter) than its peers, across
          every value we measure. Each bar is an average over all archived years — a one-glance
          read of what the copy emphasizes.
        </p>
        <div class="mt-6">
          <ValuesFingerprint axes={fingerprint.axes} client:visible />
        </div>
      </section>
    )}

    {synthesis?.fit && (
      <section class="mt-12">
        <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
          Who they're looking for
        </h2>
        <p class="mt-3 max-w-prose text-lg leading-relaxed">{synthesis.fit}</p>
      </section>
    )}

    {altruism && (
      <section class="mt-14">
        <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
          Mission &amp; idealism over time
        </h2>
        <p class="mt-3 max-w-prose text-sm text-neutral-500">
          How much the careers copy leans on "change the world" mission language (product-capability
          hype is stripped out). If purpose matters to you, the trend line shows whether it's rising
          or fading.
        </p>
        {peakQuote && (
          <p class="mt-4 max-w-prose border-l-2 border-neutral-200 pl-4 text-sm italic text-neutral-600 dark:border-neutral-700 dark:text-neutral-400">
            Most idealistic line on record ({peakQuote.year}): “{peakQuote.text}”
          </p>
        )}
        <div class="mt-6">
          <AxisExplorer axis={altruism} control={control} client:only="react" />
        </div>
      </section>
    )}

    {dei && (
      <section class="mt-14">
        <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
          Diversity &amp; inclusion language
        </h2>
        <p class="mt-3 max-w-prose text-sm text-neutral-500">
          Whether the careers pages talk about workforce diversity and belonging, and whether that
          language grew or was walked back. Near-zero means the topic is largely absent, not actively
          opposed.
        </p>
        <div class="mt-6">
          <DeiExplorer data={dei} client:only="react" />
        </div>
      </section>
    )}

    {trajectoryPanels.length > 0 && (
      <section class="mt-14">
        <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
          Other values over time
        </h2>
        <p class="mt-3 max-w-prose text-sm text-neutral-500">
          Each line tracks one value against {displayName}'s <em>own</em> history — z-scored within
          the company, so it shows when its copy leaned harder or lighter on that value, not how it
          ranks against peers. (For the peer comparison, see the fingerprint above.)
        </p>
        <div class="mt-6 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2">
          {trajectoryPanels.map((p) => (
            <div>
              <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-200">{p.label}</h3>
              <TrajectoryChart rows={p.rows} label={p.label} client:visible />
            </div>
          ))}
        </div>
      </section>
    )}

    {!altruism && !dei && trajectoryPanels.length === 0 && (
      <p class="mt-10 max-w-prose text-sm text-neutral-500">
        Detailed trajectory charts for {displayName} are still being generated.
      </p>
    )}

    {hasNarrative && synthesis.sections.length > 0 && (
      <section class="mt-16 rounded-lg border border-neutral-200 bg-neutral-50 p-6 dark:border-neutral-800 dark:bg-neutral-900/40">
        <div class="flex items-center gap-2">
          <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
            The story so far
          </h2>
          <span class="rounded-full bg-neutral-200 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-neutral-500 dark:bg-neutral-800">
            AI synthesis
          </span>
        </div>
        <div class="mt-4 space-y-5">
          {synthesis.sections.map((s) => (
            <div>
              <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-200">{s.heading}</h3>
              {s.body.split("\n\n").map((para) => (
                <p class="mt-2 max-w-prose text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
                  {para}
                </p>
              ))}
            </div>
          ))}
        </div>
        <p class="mt-5 text-xs text-neutral-400">
          Generated from the data on this page — a reading of the language, not a claim about the
          company's behavior.
        </p>
      </section>
    )}
  </main>
</Layout>

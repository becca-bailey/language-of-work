---
import StoryStanceEnvelope from "@/components/StoryStanceEnvelope";
import { loadStory } from "@/lib/stories";
import { DEI_EVENTS } from "@/lib/events";

const data = await loadStory("dei");
const envelopes = data?.envelopes ?? [];
---

{envelopes.length > 0 && (
  <div class="my-6">
    <StoryStanceEnvelope envelopes={envelopes} events={DEI_EVENTS} client:only="react" />
  </div>
)}

---
import ConcessionChart from "@/components/ConcessionChart";
import { loadStory } from "@/lib/stories";
const data = (await loadStory("wellbeing")) as any;
const rows = data?.concession ?? [];
---
{rows.length > 0 && (
  <div class="my-6"><ConcessionChart rows={rows} client:only="react" /></div>
)}

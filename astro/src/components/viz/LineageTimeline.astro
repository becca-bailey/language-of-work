---
// When the language was adopted. One track per concept across a shared year axis. Netflix's
// origin is the bold anchor; borrowed lifts are strong markers; echoes are faint dots placed
// at the year the language first appears in that company's captured snapshots (coverage is
// continuous per company, so first-appearance is a real signal, not a scraping gap). Opacity
// scales with similarity. Reads the diffusion over time and its volume at once.
import { lineageConcepts } from "./lineage";

const MIN = 2005, MAX = 2026;
const x = (y: number) => `${((Math.min(MAX, Math.max(MIN, y)) - MIN) / (MAX - MIN)) * 100}%`;
// Similarity -> depth of the info-colored echo dot (kept opaque enough to stay visible),
// derived from the --info token via color-mix so it re-themes with the palette.
const dotPct = (s: number) => Math.round(Math.min(1, Math.max(0.45, 0.45 + ((s - 0.5) / 0.15) * 0.55)) * 100);
const infoMix = (pct: number) => `color-mix(in srgb, var(--info) ${pct}%, transparent)`;
// Two shades of the borrowing orange: verbatim = full --alert, paraphrase = a lighter tint
// with a dark-orange label for contrast.
const BORROW_PARAPHRASE = "color-mix(in srgb, var(--alert) 52%, white)";
const paraphraseText = "color-mix(in srgb, var(--alert) 45%, black)";

const concepts = (await lineageConcepts()).sort((a, b) =>
  (b.adopters.length - a.adopters.length) || ((b.echoes?.length ?? 0) - (a.echoes?.length ?? 0)));
const ticks = [2005, 2010, 2015, 2020, 2025];
---

<div class="my-6 rounded-lg border border-neutral-200 p-4 dark:border-neutral-800">
  <div class="relative mb-3 ml-[150px] h-4 text-[10px] text-neutral-400">
    {ticks.map((t) => (<span class="absolute -translate-x-1/2" style={`left:${x(t)}`}>{t}</span>))}
  </div>
  <div class="space-y-2">
    {concepts.map((c) => (
      <div class="flex items-center gap-2">
        <div class="w-[142px] shrink-0 text-right text-xs text-neutral-600 dark:text-neutral-300">
          {c.label}
          <span class="ml-1 font-mono text-[10px] text-neutral-400">{(c.echoes ?? []).length || ""}</span>
        </div>
        <div class="relative h-8 flex-1 border-l border-neutral-200 dark:border-neutral-800">
          <div class="absolute inset-x-0 top-1/2 h-px bg-neutral-100 dark:bg-neutral-800/70"></div>
          {ticks.map((t) => (<div class="absolute top-1/2 h-1.5 w-px -translate-y-1/2 bg-neutral-200 dark:bg-neutral-800" style={`left:${x(t)}`}></div>))}
          {/* echoes: faint dots by year */}
          {(c.echoes ?? []).map((e) => (
            <span title={`${e.displayName} ${e.year} · ${e.score.toFixed(2)} (adjacent)\n“${e.example}”`}
              class="absolute top-1/2 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 cursor-help rounded-full"
              style={`left:${x(e.year)};background:${infoMix(dotPct(e.score))}`}></span>
          ))}
          {/* borrowed lifts: strong markers */}
          {c.adopters.map((a) => (
            <span title={`${a.displayName} ${a.year} · ${(a.score ?? 0).toFixed(2)} ${a.verbatim ? "near-verbatim" : "paraphrase"}\n“${a.example}”`}
              class="absolute top-1/2 z-10 flex h-4 -translate-x-1/2 -translate-y-1/2 items-center rounded px-1 text-[9px] font-medium cursor-help"
              style={`left:${x(a.year)};background:${a.verbatim ? "var(--alert)" : BORROW_PARAPHRASE};color:${a.verbatim ? "#fff" : paraphraseText}`}>{a.displayName}</span>
          ))}
          {/* Netflix origin: bold anchor */}
          <span title={`Netflix ${c.originYear ?? 2009} — origin\n“${c.originQuote}”`}
            class="absolute top-1/2 z-20 h-3.5 w-3.5 -translate-x-1/2 -translate-y-1/2 cursor-help rounded-full border-2 border-white dark:border-neutral-900"
            style={`left:${x(c.originYear ?? 2009)};background:var(--origin)`}></span>
        </div>
      </div>
    ))}
  </div>
  <p class="mt-4 flex flex-wrap gap-3 text-[10px] text-neutral-400">
    <span><span class="mr-1 inline-block h-2.5 w-2.5 rounded-full border border-white align-middle" style="background:var(--origin)"></span>Netflix origin</span>
    <span><span class="mr-1 inline-block h-2 w-3 rounded-sm align-middle" style="background:var(--alert)"></span>borrowed (near-verbatim)</span>
    <span><span class="mr-1 inline-block h-2 w-3 rounded-sm align-middle" style="background:color-mix(in srgb, var(--alert) 52%, white)"></span>borrowed (paraphrase)</span>
    <span><span class="mr-1 inline-block h-2 w-2 rounded-full align-middle" style="background:color-mix(in srgb, var(--info) 85%, transparent)"></span>adjacent language (fainter = weaker match)</span>
    <span class="italic">number after label = echo count · hover for quotes</span>
  </p>
</div>

---
// "Masculine Energy" unit chart: one square = one careers-page sentence,
// projected on the Kozlowski-style gender axis (src/lowork/gender_axis.py).
//
// Default layout (Becca-approved 2026-07-23): DIVERGING ROWS — one row per
// company, feminine-coded squares growing left, masculine-coded growing right
// from a shared center line, strongest scores furthest out, neutral collapsed
// to a count. Toggle: STACKED COLUMNS — every square incl. neutral, so column
// height is true corpus volume. Neutral squares are server-rendered but hidden
// in rows mode, which is what makes the toggle a pure CSS/DOM flip.
//
// Colors are palette chart-series tokens (--alert is reserved, never a series).
// Data: astro/src/data/stories/gender-language.json (export_gender_story.py).
import { loadStory } from "@/lib/stories";

const data = (await loadStory("gender-language")) as any;
const columns = (data?.columns ?? []) as {
  company: string; name: string; n: number; mascPct: number; femPct: number;
  meanZ: number; items: { z: number; y: number; t: string }[];
}[];
const initial = [...columns].sort((a, b) => b.mascPct - a.mascPct || b.meanZ - a.meanZ);

const fill = (z: number) => {
  const mag = Math.min(1, Math.max(0, (Math.abs(z) - 0.5) / 2.0));
  const depth = 45 + Math.round(mag * 55);
  if (z >= 0.5) return `color-mix(in srgb, var(--chart-contrast-1) ${depth}%, transparent)`;
  if (z <= -0.5) return `color-mix(in srgb, var(--chart-2) ${depth}%, transparent)`;
  return "var(--gu-neutral)";
};

// items arrive z-descending. masc: weakest-first so squares grow outward to the
// right (strongest at far right). fem: strongest-first so the far left is the
// strongest (rows read outward from the center line in both directions).
const split = (items: { z: number; y: number; t: string }[]) => ({
  masc: items.filter((i) => i.z >= 0.5).reverse(),
  fem: items.filter((i) => i.z <= -0.5),
  neu: items.filter((i) => i.z > -0.5 && i.z < 0.5),
});

---

<div class="gender-unit-chart mode-rows relative my-6 rounded-lg border border-neutral-200 p-4 dark:border-neutral-800">
  <div class="mb-2 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-neutral-500">
    <span role="group" aria-label="Layout" class="flex items-center gap-1">
      layout
      <button data-layout="rows" aria-pressed="true" class="gu-btn">diverging rows</button>
      <button data-layout="cols" aria-pressed="false" class="gu-btn">stacked columns (volume)</button>
    </span>
    <span role="group" aria-label="Sort columns" class="flex items-center gap-1">
      sort
      <button data-sort="masc" aria-pressed="true" class="gu-btn">masculine share</button>
      <button data-sort="fem" aria-pressed="false" class="gu-btn">feminine share</button>
      <button data-sort="size" aria-pressed="false" class="gu-btn">corpus size</button>
      <button data-sort="alpha" aria-pressed="false" class="gu-btn">A–Z</button>
    </span>
  </div>
  <div class="gu-axis-note font-mono text-[10.5px] text-neutral-400">
    <span class="gu-axis-fem">← feminine-coded</span>
    <span class="gu-axis-masc">masculine-coded →</span>
  </div>
  <div class="gu-cos">
    {initial.map((c) => {
      const g = split(c.items);
      return (
        <div class="gu-co" data-company={c.company} data-masc={c.mascPct} data-fem={c.femPct}
          data-size={c.n} data-name={c.name} data-meanz={c.meanZ}>
          <h4 class="gu-name text-[12.5px] font-semibold">{c.name}</h4>
          <div class="gu-stat-l font-mono text-[10.5px] tabular-nums text-neutral-500">
            <b style="color:var(--chart-2)">{c.femPct}%</b>
          </div>
          <div class="gu-half gu-fem">
            {g.fem.map((it) => (
              <span class="gu-sq" style={`background:${fill(it.z)}`}
                data-z={it.z} data-y={it.y} data-t={it.t}></span>
            ))}
          </div>
          <div class="gu-half gu-masc">
            {g.masc.map((it) => (
              <span class="gu-sq" style={`background:${fill(it.z)}`}
                data-z={it.z} data-y={it.y} data-t={it.t}></span>
            ))}
          </div>
          <div class="gu-neu">
            {g.neu.map((it) => (
              <span class="gu-sq" style={`background:${fill(it.z)}`}
                data-z={it.z} data-y={it.y} data-t={it.t}></span>
            ))}
          </div>
          <div class="gu-stat-r font-mono text-[10.5px] tabular-nums text-neutral-500">
            <b style="color:var(--chart-contrast-1)">{c.mascPct}%</b>
            <span class="gu-neu-count"> · {g.neu.length} neutral</span>
            <span class="gu-n"> · n={c.n}</span>
          </div>
        </div>
      );
    })}
  </div>
  <p class="mt-4 flex flex-wrap gap-3 text-[10px] text-neutral-400">
    <span><span class="mr-1 inline-block h-2 w-2 rounded-sm align-middle" style="background:var(--chart-2)"></span>feminine-coded (z ≤ −0.5)</span>
    <span><span class="mr-1 inline-block h-2 w-2 rounded-sm align-middle" style="background:var(--gu-neutral)"></span>neutral band (−0.5 … +0.5)</span>
    <span><span class="mr-1 inline-block h-2 w-2 rounded-sm align-middle" style="background:var(--chart-contrast-1)"></span>masculine-coded (z ≥ +0.5)</span>
    <span class="italic">one square = one sentence · deeper = further from neutral · hover for the sentence</span>
  </p>
  <div class="gu-tip pointer-events-none absolute z-30 hidden w-max max-w-[320px] rounded-md border border-neutral-200 bg-white px-3 py-2 shadow-lg dark:border-neutral-700 dark:bg-neutral-900" role="tooltip" aria-hidden="true">
    <p class="gu-tip-z font-mono text-xs font-semibold"></p>
    <p class="gu-tip-q mt-0.5 text-xs italic leading-snug text-neutral-600 dark:text-neutral-300"></p>
    <p class="gu-tip-m mt-0.5 text-[10px] text-neutral-400"></p>
  </div>
</div>

<style>
  .gender-unit-chart {
    --gu-neutral: color-mix(in srgb, var(--muted) 22%, var(--background));
  }
  .gu-btn {
    border: 1px solid color-mix(in srgb, var(--muted) 45%, transparent);
    border-radius: 5px;
    padding: 1px 8px;
    color: var(--foreground);
  }
  .gu-btn[aria-pressed="true"] {
    background: var(--foreground);
    color: var(--background);
    border-color: var(--foreground);
  }
  .gu-btn:focus-visible { outline: 2px solid var(--chart-contrast-1); outline-offset: 1px; }
  .gu-sq { width: 5px; height: 5px; border-radius: 1px; background: var(--gu-neutral); }

  /* ---- rows mode (default): diverging composition ---- */
  .mode-rows .gu-axis-note,
  .mode-rows .gu-co {
    display: grid;
    grid-template-columns: 108px 44px minmax(0, 1fr) minmax(0, 1fr) 150px;
    gap: 8px;
    align-items: center;
  }
  .mode-rows .gu-axis-note { margin-bottom: 6px; }
  .mode-rows .gu-axis-fem { grid-column: 3; text-align: right; }
  .mode-rows .gu-axis-masc { grid-column: 4; }
  .mode-rows .gu-cos { display: flex; flex-direction: column; gap: 9px; }
  .mode-rows .gu-name { margin: 0; text-align: right; }
  .mode-rows .gu-stat-l { text-align: right; }
  .mode-rows .gu-half { display: flex; flex-wrap: wrap; gap: 1px; align-content: center; min-height: 5px; }
  .mode-rows .gu-fem { justify-content: flex-end; }
  .mode-rows .gu-neu { display: none; }
  .mode-rows .gu-fem { border-right: 1px solid color-mix(in srgb, var(--muted) 40%, transparent); padding-right: 4px; }
  .mode-rows .gu-masc { padding-left: 4px; }
  .mode-rows .gu-n { display: none; }

  /* ---- cols mode: stacked volume (masc → neutral → fem, score-ordered) ---- */
  .mode-cols .gu-axis-note { display: none; }
  .mode-cols .gu-cos { display: flex; flex-wrap: wrap; gap: 30px 20px; align-items: flex-end; }
  .mode-cols .gu-co { display: flex; flex-direction: column-reverse; width: 90px; }
  /* column-reverse stacks visual order bottom-up: stat-r, name at bottom; squares above */
  .mode-cols .gu-name { margin: 8px 0 1px; order: 2; text-align: left; }
  .mode-cols .gu-stat-l { display: none; }
  .mode-cols .gu-stat-r { order: 1; }
  .mode-cols .gu-neu-count { display: none; }
  .mode-cols .gu-half, .mode-cols .gu-neu {
    display: flex; flex-wrap: wrap; gap: 1px; width: 89px;
  }
  /* stack: masc (top, strongest first via wrap-reverse trick handled in JS), then neutral, then fem */
  .mode-cols .gu-fem { order: 5; }
  .mode-cols .gu-neu { order: 4; }
  .mode-cols .gu-masc { order: 3; }
  .mode-cols .gu-fem { border-right: none; padding-right: 0; }
  .mode-cols .gu-masc { padding-left: 0; }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>(".gender-unit-chart")) {
    const cosBox = root.querySelector<HTMLElement>(".gu-cos")!;
    const tip = root.querySelector<HTMLElement>(".gu-tip")!;
    const tz = tip.querySelector<HTMLElement>(".gu-tip-z")!;
    const tq = tip.querySelector<HTMLElement>(".gu-tip-q")!;
    const tm = tip.querySelector<HTMLElement>(".gu-tip-m")!;

    // rows mode renders masc weakest-first (grows outward right) and fem
    // strongest-first (far left). cols mode wants score order top-to-bottom:
    // masc strongest-first, fem weakest-first — i.e. both groups reversed.
    const reverseGroups = () => {
      for (const g of cosBox.querySelectorAll<HTMLElement>(".gu-masc, .gu-fem"))
        for (const child of [...g.children].reverse()) g.appendChild(child);
    };

    const applySort = (mode: string) => {
      const cos = [...cosBox.querySelectorAll<HTMLElement>(".gu-co")];
      cos.sort((a, b) =>
        mode === "masc" ? (+b.dataset.masc! - +a.dataset.masc!) || (+b.dataset.meanz! - +a.dataset.meanz!) :
        mode === "fem" ? (+b.dataset.fem! - +a.dataset.fem!) || (+a.dataset.meanz! - +b.dataset.meanz!) :
        mode === "size" ? +b.dataset.size! - +a.dataset.size! :
        a.dataset.name!.localeCompare(b.dataset.name!));
      for (const c of cos) cosBox.appendChild(c);
    };

    for (const b of root.querySelectorAll<HTMLElement>("[data-layout]"))
      b.addEventListener("click", () => {
        if (root.classList.contains(`mode-${b.dataset.layout}`)) return;
        root.querySelectorAll("[data-layout]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        root.classList.toggle("mode-rows");
        root.classList.toggle("mode-cols");
        reverseGroups();
      });
    for (const b of root.querySelectorAll<HTMLElement>("[data-sort]"))
      b.addEventListener("click", () => {
        root.querySelectorAll("[data-sort]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        applySort(b.dataset.sort!);
      });

    cosBox.addEventListener("pointerover", (e) => {
      const s = (e.target as HTMLElement).closest<HTMLElement>(".gu-sq");
      if (!s) { tip.classList.add("hidden"); return; }
      const zv = parseFloat(s.dataset.z!);
      tz.textContent = (zv > 0 ? "+" : "") + zv.toFixed(2) + "z " +
        (zv >= 0.5 ? "masculine-coded" : zv <= -0.5 ? "feminine-coded" : "neutral");
      tz.style.color = zv >= 0.5 ? "var(--chart-contrast-1)" : zv <= -0.5 ? "var(--chart-2)" : "";
      tq.textContent = "“" + (s.dataset.t ?? "") + "”";
      tm.textContent = "first captured " + s.dataset.y;
      tip.classList.remove("hidden");
      tip.setAttribute("aria-hidden", "false");
      const rb = root.getBoundingClientRect(), r = s.getBoundingClientRect();
      const tw = tip.offsetWidth, th = tip.offsetHeight;
      const x = Math.min(Math.max(4, r.left - rb.left + r.width / 2 - tw / 2), rb.width - tw - 4);
      let y = r.top - rb.top - th - 8;
      if (y < 4) y = r.bottom - rb.top + 8;
      tip.style.left = x + "px"; tip.style.top = y + "px";
    });
    cosBox.addEventListener("pointerleave", () => tip.classList.add("hidden"));
  }
</script>

---
import StoryYearCompare from "@/components/StoryYearCompare";
import { loadStory } from "@/lib/stories";

const data = await loadStory("altruism");
const quotes = data?.yearQuotes ?? [];
---

{quotes.length > 0 && (
  <div class="my-6">
    <StoryYearCompare quotes={quotes} client:only="react" />
  </div>
)}

---
import { loadCultureFitStory } from "@/lib/cultureFitStory";

const data = await loadCultureFitStory();
const cards = data?.cards ?? [];
---

{cards.length > 0 && (
  <div class="my-6 space-y-6">
    {cards.map((c) => (
      <section class="rounded-lg border border-neutral-200 p-5 dark:border-neutral-800">
        <h2 class="text-lg font-semibold tracking-tight">{c.displayName}</h2>
        <p class="mt-1 max-w-prose text-sm text-neutral-700 dark:text-neutral-300">{c.summary}</p>
        <ul class="mt-3 space-y-2">
          {c.quotes.map((q) => (
            <li class="border-l-2 border-neutral-200 pl-3 text-sm italic text-neutral-600 dark:border-neutral-700 dark:text-neutral-400">
              <span class="mr-1 not-italic tabular-nums text-xs text-neutral-400">{q.year}</span>
              &ldquo;{q.text}&rdquo;
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
)}

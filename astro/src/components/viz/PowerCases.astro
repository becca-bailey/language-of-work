---
import { loadPowerStory } from "@/lib/powerStory";

const data = await loadPowerStory();
const cases = data?.cases ?? [];
---

{cases.length > 0 && (
  <div class="my-6 grid gap-4 sm:grid-cols-2">
    {cases.map((c) => (
      <div class="rounded-lg border border-neutral-200 p-4 dark:border-neutral-800">
        <p class="font-semibold">
          {c.company} <span class="font-normal text-neutral-400">· {c.date}</span>
        </p>
        <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{c.shift}</p>
        <ul class="mt-2 space-y-1">
          {c.quotes.map((q) => (
            <li class="border-l-2 border-rose-300 pl-2 text-sm italic text-neutral-700 dark:border-rose-700/60 dark:text-neutral-300">
              &ldquo;{q}&rdquo;
            </li>
          ))}
        </ul>
        <p class="mt-2 text-[11px] text-neutral-400">{c.source}</p>
      </div>
    ))}
  </div>
)}

---
import { loadStory } from "@/lib/stories";

interface Adopter {
  company: string;
  displayName: string;
  year: number;
  verbatim?: boolean;
  example?: string;
  score?: number | null;
}
interface Concept {
  id: string;
  label: string;
  tier: string;
  originYear?: number | null;
  originQuote?: string | null;
  adopters: Adopter[];
}

const data = await loadStory("netflix-culture");
const concepts = ((data as any)?.propagation?.concepts ?? []) as Concept[];

// Lifts: Netflix idea that propagated. Rank by closeness of the borrowing
// (verbatim first, then similarity) so the starkest lineage leads.
// Guard against verbatim-only entries that carry no example text — a blank
// blockquote would render otherwise.
const lifts = concepts
  .map((c) => ({ ...c, adopters: c.adopters.filter((a) => a.example) }))
  .filter((c) => c.tier === "lift" && c.originQuote && c.adopters.length)
  .sort((a, b) => (b.adopters[0]?.score ?? 0) - (a.adopters[0]?.score ?? 0));

// Distinctive Netflix ideas that no one echoed above threshold.
const stayed = concepts.filter((c) => c.tier === "netflix_only" && c.originQuote);
---

<div class="my-8 space-y-5">
  {
    lifts.map((c) => (
      <div class="rounded-lg border border-neutral-200 p-4 dark:border-neutral-800">
        <p class="font-mono text-[11px] uppercase tracking-wide text-neutral-500">{c.label}</p>
        <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center">
          <blockquote class="flex-1 border-l-2 border-neutral-400 pl-3 dark:border-neutral-600">
            <p class="text-sm italic leading-relaxed text-neutral-800 dark:text-neutral-200">
              &ldquo;{c.originQuote}&rdquo;
            </p>
            <p class="mt-1 font-mono text-xs text-neutral-400">Netflix · {c.originYear ?? 2009}</p>
          </blockquote>
          <div class="shrink-0 self-center text-neutral-400" aria-hidden="true">&rarr;</div>
          <div class="flex-1 space-y-2">
            {c.adopters.map((a) => (
              <blockquote class={`border-l-2 pl-3 ${a.verbatim ? "border-rose-500" : "border-indigo-400"}`}>
                <p class="text-sm italic leading-relaxed text-neutral-800 dark:text-neutral-200">
                  &ldquo;{a.example}&rdquo;
                </p>
                <p class="mt-1 font-mono text-xs text-neutral-400">
                  {a.displayName} · {a.year}
                  <span class={`ml-2 rounded px-1 py-0.5 text-[10px] ${a.verbatim ? "bg-rose-100 text-rose-700 dark:bg-rose-950/50 dark:text-rose-300" : "bg-indigo-100 text-indigo-700 dark:bg-indigo-950/50 dark:text-indigo-300"}`}>
                    {a.verbatim ? "near-verbatim" : "paraphrase"}
                    {a.score != null ? ` · ${a.score.toFixed(2)}` : ""}
                  </span>
                </p>
              </blockquote>
            ))}
          </div>
        </div>
      </div>
    ))
  }
</div>

{
  stayed.length > 0 && (
    <div class="my-8">
      <p class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Stayed at Netflix</p>
      <p class="mt-1 max-w-prose text-xs text-neutral-500">
        The bluntest formulations never traveled — no company in the corpus echoed them above
        the validated similarity threshold.
      </p>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {stayed.map((c) => (
          <li class="rounded-lg border border-dashed border-neutral-200 p-3 dark:border-neutral-800">
            <p class="text-sm italic leading-relaxed text-neutral-700 dark:text-neutral-300">
              &ldquo;{c.originQuote}&rdquo;
            </p>
            <p class="mt-1 font-mono text-xs text-neutral-400">Netflix · {c.originYear ?? 2009} — no adopters</p>
          </li>
        ))}
      </ul>
    </div>
  )
}

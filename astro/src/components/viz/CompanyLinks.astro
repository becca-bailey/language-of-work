---
import StoryCompanyLinks from "@/components/StoryCompanyLinks";
import { loadStory } from "@/lib/stories";

interface Props {
  story: string;
  axis?: string;
}

const { story, axis } = Astro.props;
const data = await loadStory(story);
const companies =
  data?.sources.careers?.companies.map((c) => ({ id: c.id, displayName: c.displayName })) ?? [];
---

{companies.length > 0 && <StoryCompanyLinks companies={companies} axis={axis ?? story} />}

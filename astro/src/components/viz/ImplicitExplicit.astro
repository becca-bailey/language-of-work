---
import { loadNetflixStory } from "@/lib/netflixStory";

const n = await loadNetflixStory();
---

{n && (
  <div class="my-6 overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr class="border-b border-neutral-200 text-left text-xs uppercase tracking-wide text-neutral-500 dark:border-neutral-800">
          <th class="py-2 pr-4 font-medium">Netflix, explicit</th>
          <th class="py-2 font-medium">Industry, implicit</th>
        </tr>
      </thead>
      <tbody>
        {n.implicitExplicit.map((m) => (
          <tr class="border-b border-neutral-100 dark:border-neutral-800/60">
            <td class="py-2 pr-4 text-neutral-700 dark:text-neutral-300">{m.explicit}</td>
            <td class="py-2 text-neutral-600 dark:text-neutral-400">{m.implicit}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

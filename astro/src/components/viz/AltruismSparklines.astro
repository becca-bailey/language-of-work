---
import StorySparklines from "@/components/StorySparklines";
import { loadStory } from "@/lib/stories";

interface Props {
  metricLabel?: string;
}
const { metricLabel } = Astro.props;

const data = await loadStory("altruism");
const companies = data?.sources.careers?.companies ?? [];
// Headline line uses the cleaned (techno-removed) world-changing series where available.
const cleaned = companies.map((c) => (c.worldChanging ? { ...c, years: c.worldChanging } : c));
---

{cleaned.length > 0 && (
  <div class="my-6">
    <StorySparklines companies={cleaned} metricLabel={metricLabel} client:only="react" />
  </div>
)}

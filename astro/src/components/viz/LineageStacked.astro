---
// Which language matches best. A bold origin card per concept; if the idea was borrowed, the
// lift sits beside it as a strong "clearly borrowed" card. Beneath, the adjacent-language
// echoes stack up — one card per company, ordered by year, with opacity scaled to similarity
// so a tall-but-faint stack (diffuse, generic) reads visibly weaker than a real borrowing.
// The stack height = how far the softened version of the idea diffused.
import { lineageConcepts, type Concept } from "./lineage";

// Encode similarity as the depth of an info-colored bar/tint — NOT whole-card opacity, so the
// text stays fully readable while a stronger match reads as a deeper color. Derived from the
// --info token via color-mix, so it re-themes with the palette (no hardcoded color).
const infoMix = (pct: number) => `color-mix(in srgb, var(--info) ${pct}%, transparent)`;
// Two shades of the borrowing orange: verbatim = full --alert, paraphrase = a lighter tint.
const BORROW_VERBATIM = "var(--alert)";
const BORROW_PARAPHRASE = "color-mix(in srgb, var(--alert) 52%, white)";
const barPct = (s: number) => Math.round(Math.min(1, Math.max(0.4, 0.4 + ((s - 0.5) / 0.15) * 0.6)) * 100);
const tintPct = (s: number) => Math.round((0.04 + Math.max(0, Math.min(1, (s - 0.5) / 0.15)) * 0.09) * 100);

const all = await lineageConcepts();
// Borrowed concepts first, then by echo volume (breadth of adjacent language).
const concepts = all.sort((a, b) =>
  (b.adopters.length - a.adopters.length) || ((b.echoes?.length ?? 0) - (a.echoes?.length ?? 0)));
const byYear = (c: Concept) => [...(c.echoes ?? [])].sort((x, y) => x.year - y.year);
---

<div class="my-6 space-y-4">
  {concepts.map((c) => {
    const echoes = byYear(c);
    return (
      <div class="rounded-lg border border-neutral-200 p-4 dark:border-neutral-800">
        {/* origin + borrowed (the lineage for exact matches, stacked vertically) */}
        <div class="flex flex-col gap-3">
          <div class="rounded-md border-2 border-origin bg-origin/5 p-3 dark:bg-origin/10">
            <p class="font-mono text-[10px] uppercase tracking-wide text-origin">{c.label} · origin</p>
            <p class="mt-1 text-[15px] font-semibold italic leading-snug text-neutral-800 dark:text-neutral-100">&ldquo;{c.originQuote}&rdquo;</p>
            <p class="mt-1 font-mono text-[11px] text-neutral-400">Netflix · {c.originYear ?? 2009}</p>
          </div>
          {c.adopters.length > 0 && (
            <div class="flex flex-col gap-2">
              {c.adopters.map((a) => (
                <div class="rounded-md border-l-4 bg-neutral-50 p-3 dark:bg-neutral-900"
                     style={`border-left-color:${a.verbatim ? BORROW_VERBATIM : BORROW_PARAPHRASE}`}>
                  <p class="text-xs font-semibold text-neutral-700 dark:text-neutral-200">
                    {a.verbatim ? "Borrowed — near-verbatim" : "Borrowed — paraphrase"}
                    <span class="ml-1 font-mono font-normal text-neutral-400">{(a.score ?? 0).toFixed(2)}</span>
                  </p>
                  <p class="mt-1 text-sm italic leading-snug text-neutral-700 dark:text-neutral-300">&ldquo;{a.example}&rdquo;</p>
                  <p class="mt-1 font-mono text-[11px] text-neutral-400">{a.displayName} · {a.year}</p>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* adjacent-language echo stack (volume) */}
        <div class="mt-3">
          <p class="font-mono text-[10px] uppercase tracking-wide text-neutral-400">
            Adjacent language · {echoes.length} {echoes.length === 1 ? "company" : "companies"}
            {echoes.length === 0 && " — none"}
          </p>
          {echoes.length > 0 && (
            <div class="mt-2 space-y-1.5">
              {echoes.map((e) => (
                <div class="flex items-baseline gap-3 rounded-md border-l-[3px] px-2.5 py-1.5 text-sm"
                     style={`border-left-color:${infoMix(barPct(e.score))};background:${infoMix(tintPct(e.score))}`}>
                  <span class="w-24 shrink-0 font-mono text-xs text-neutral-500 dark:text-neutral-400">{e.displayName} · {e.year}</span>
                  <span class="flex-1 italic leading-snug text-neutral-700 dark:text-neutral-200">&ldquo;{e.example}&rdquo;</span>
                  <span class="shrink-0 font-mono text-xs text-neutral-400">{e.score.toFixed(2)}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    );
  })}
</div>

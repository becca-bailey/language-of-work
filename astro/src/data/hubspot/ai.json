          "group": "talk",
          "terms": [
            "AI"
          ],
          "projection": 0.0218,
          "text": "Discover how we’re using AI to enhance human connection in talent acquisition, transforming the candidate journey and elevating recruiter roles to strategic partners at HubSpot."
        },
